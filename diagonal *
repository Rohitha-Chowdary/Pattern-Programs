public class Demo {
    public static void main(String[] args) {

        int num = 3;
        for (int i=1; i<=num;i++){
            for (int j=1;j<=num;j++){
                
                if(i == j) {
                   System.out.println("*");
                    
                }else{
                    System.out.println(" ");
                }
            }
            System.out.println()
        }
    }
